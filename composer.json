{
    "name": "pedrotroller/php-cs-custom-fixer",
    "description": "PHP-CS-FIXER : my custom fixers",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "friendsofphp/php-cs-fixer": "^3.95.5"
    },
    "require-dev": {
        "phpspec/phpspec": "^8.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.7",
        "sebastian/diff": "^4.0",
        "twig/twig": "^3.3",
        "webmozart/assert": "^1.10"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "PedroTroller\\CS\\Fixer\\": "src/PedroTroller/CS/Fixer"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "spec\\": "spec",
            "tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.x-dev"
        }
    },
    "scripts": {
        "lint": [
            "@php-cs-fixer"
        ],
        "php-cs-fixer": [
            "php-cs-fixer fix --dry-run -vvv --diff"
        ],
        "phpstan": [
            "phpstan analyse --no-progress --memory-limit=1G"
        ],
        "tests": [
            "tests\\Runner::run",
            "tests\\Orchestra::run",
            "phpspec run -fpretty"
        ]
    }
}
